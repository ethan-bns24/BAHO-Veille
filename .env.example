# Laissez SMTP_HOST vide pour tracer les notifications dans la base sans rien envoyer.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=veille@baho.example
# Adresse de réponse affichée dans l'alerte. À défaut, SMTP_FROM est repris.
SMTP_REPLY_TO=

# Destinataires séparés par des virgules. Prioritaire sur notification.recipients
# de settings.toml, mais les destinataires saisis dans le tableau de bord l'emportent.
ALERT_RECIPIENTS=direction@baho.example

# Identifiants des plateformes à flux protégé, référencés par `username_env` /
# `password_env` dans settings.toml. À ne renseigner qu'au moment de leur activation.
PLACE_USERNAME=
PLACE_PASSWORD=
